<%- include('../includes/head.ejs') %>
<%- include('../includes/heading.ejs') %>

<main>
  <div class="container">
    <% if(hasError){ %>
      <% if(errorMessage){ %>
            <div class="alert alert-danger"><%= errorMessage %></div>
      <% } %>
    <% }  %>

    <form action="/admin/<% if(editing){ %>edit-product<% }else{ %>add-product<% } %>" method="post" novalidate enctype="multipart/form-data">
      
      <div class="form-group">
        <label for="title">عنوان</label>
        <input type="text" class="form-control <%= validationErrors.find(e => e.path === 'title') ? 'border border-danger' : '' %>" id="title" name="title" placeholder="نام محصول را وارد کنید" value="<% if(editing || hasError){ %><%= product.title %><% } %>" />
      </div>
      <div class="form-group">
        <label for="price">قیمت</label>
        <input type="number" class="form-control <%= validationErrors.find(e => e.path === 'price') ? 'border border-danger' : '' %>" id="price" name="price" placeholder="قیمت محصول را وارد کنید"  value="<% if(editing || hasError){ %><%= product.price %><% } %>" />
      </div>
      <div class="form-group">
        <label for="image">آدرس عکس</label>
        <input type="file" class="form-control <%= validationErrors.find(e => e.path === 'image') ? 'border border-danger' : '' %>" id="image" name="image" placeholder="عکس محصول را وارد کنید" />
      </div>
      <div class="form-group">
        <label for="description">توضیحات</label>
        <textarea class="form-control <%= validationErrors.find(e => e.path === 'description') ? 'border border-danger' : '' %>" name="description" cols="30" rows="10"><% if(editing || hasError){ %><%= product.description %><% } %></textarea>
      </div>

      <% if(editing){ %>
        <input type="hidden" name="productID" value="<%= product._id %>" />
      <% } %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-primary"><% if(editing){ %>ویرایش محصول<% }else{ %>افزودن محصول<% } %></button>
    </form>

  </div>
</main>


<%- include('../includes/footer.ejs') %>
<%- include('../includes/end.ejs') %>