<%- include('../includes/head.ejs') %>
<%- include('../includes/heading.ejs') %>

<main>
    <div class="container">
        <div class="centered">
            <div class="card product-details">
                <h2 class="card-header"><%= product.title %></h2>
                <div class="card-body">
                    <img src="/<%= product.image %>" alt="<%= product.title %>">
                    <div class="text-centered">
                        <h4 class="card-text"><%= product.description %></h4>
                        <hr />
                        <span class="product__price product-details__price"><%= product.price %> تومان</span>
                    </div>
                    <div class="product-details__actions">
                        <a href="/products" class="btn btn-light">بازگشت به محصولات</a>
                        <% if(isAuthenticated){ %>
                          <form action="/cart" method="post">
                            <input type="hidden" name="productID" value="<%= product._id %>" />
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button class="btn btn-info">افزودن به سبد</button>
                          </form>
                        <% } else { %>
                          <a href="/login" class="btn btn-info">برای خرید وارد شوید</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../includes/footer.ejs') %>
<%- include('../includes/end.ejs') %>